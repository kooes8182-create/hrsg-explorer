# backend/.env.example — 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# .env 는 Git에 올리지 않습니다. 이 파일에는 실제 비밀값을 넣지 않습니다.

# Django 비밀 키 (아래 명령으로 생성해 붙여 넣기)
#   .venv/bin/python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# 기본 False (시연·평소 실행). True 로 켜면 오류 화면에 내부 정보가 보일 수 있으니 문제를 찾을 때만 잠깐 켜세요.
DJANGO_DEBUG=False

# PostgreSQL (로컬)
DB_NAME=hrsg_ref
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# 향후 실제 LLM 연결 시 사용 (현재는 연결 코드가 없어 읽지 않음 — 앱은 항상 템플릿 데모 답변으로 동작)
# 연결 위치·절차: backend/qa/service.py get_provider(), specs/06_ai_qa.md §7
QA_PROVIDER=demo
LLM_API_KEY=
LLM_MODEL=

# 논문 근거 질문(RAG) — Gemini 답변 생성 (Google AI Studio 키. 값은 .env 에만, 커밋 금지)
#   비워 두면 답변을 만들지 않고 화면에 '답변 생성 API 설정 필요' 를 표시합니다 (검색·근거 확인은 동작).
GEMINI_API_KEY=
# 비우면 gemini-3.5-flash (gemini-2.5-flash 는 새 사용자에게 열려 있지 않음)
RAG_LLM_MODEL=

# (선택) 자료 위치 — 비우면 HRSG/reference/papers, HRSG/data/prototype 등 기본 위치
RAG_PAPERS_DIR=
RAG_CORPUS_DIR=
RAG_EVAL_FILE=
# (선택) 한국어→영어 용어 목록 JSON (BM25 질의에만 덧붙임). 공식 목록이 없어 기본은 사용 안 함
RAG_TERM_EXPANSION=
# (선택) 임베딩 실행 장치: mps / cpu (비우면 자동). RAG_EMBEDDER 는 local 만 구현됨
RAG_EMBED_DEVICE=
