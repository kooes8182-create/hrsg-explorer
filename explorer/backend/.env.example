# explorer/backend/.env.example — 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# .env 는 Git에 올리지 않습니다. 이 파일에는 실제 비밀값을 넣지 않습니다.

# Django 비밀 키 (아래 명령으로 생성해 붙여 넣기)
#   .venv/bin/python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# 기본 False. True 로 켜면 오류 화면에 내부 정보가 보일 수 있으니 문제를 찾을 때만 잠깐 켜세요.
DJANGO_DEBUG=False

# PostgreSQL (로컬) — 이 앱 전용 DB. HRSG 앱의 hrsg_ref 와 섞지 않습니다.
DB_NAME=hrsg_explorer
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# AI 답변 (Claude — Anthropic API). 비워 두면 근거 검색만 제공합니다.
# 키는 이 파일이 아니라 .env 에만 직접 넣으세요. 채팅·코드·Git 에 붙여 넣지 마세요.
ANTHROPIC_API_KEY=
# 비워 두면 claude-opus-5-5. 바꾸려면 예: claude-sonnet-5-5, claude-haiku-5-5
RAG_LLM_MODEL=
